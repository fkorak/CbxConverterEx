#include "resource.h"
#include <winres.h>

IDI_APP_ICON ICON "Assets\\CbxConverterEx.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CBX_VERSION_MAJOR,CBX_VERSION_MINOR,0,0
 PRODUCTVERSION CBX_VERSION_MAJOR,CBX_VERSION_MINOR,0,0
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", CBX_APP_NAME_A " - comic book file converter (modified CbxConverter)"
            VALUE "FileVersion", CBX_VERSION_STRING
            VALUE "CompanyName", "Fabian Korak (github.com/fkorak)"
            VALUE "LegalCopyright", "Based on CbxConverter, Copyright (C) Tomasz Ostrowski 2013-2026. Modified 2026 by Fabian Korak with AI assistance (Claude Code). GPL v2"
            VALUE "ProductName", CBX_APP_NAME_A
            VALUE "ProductVersion", CBX_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
