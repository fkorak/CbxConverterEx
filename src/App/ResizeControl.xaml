<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CbxConverter.ResizeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="14" MinWidth="400">
        <ComboBox x:Name="ModeCombo" Header="Resize mode" HorizontalAlignment="Stretch" SelectionChanged="OnModeChanged">
            <x:String>regular - same, proportional resizing for all images</x:String>
            <x:String>resize if oversized</x:String>
        </ComboBox>

        <StackPanel x:Name="RegularPanel" Spacing="8">
            <NumberBox x:Name="PctBox" Header="Resize to [%]" Minimum="1" Maximum="999" SmallChange="1" LargeChange="10"
                       SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="25%" Tag="25" Click="OnPresetClick" />
                <Button Content="33%" Tag="33" Click="OnPresetClick" />
                <Button Content="50%" Tag="50" Click="OnPresetClick" />
                <Button Content="66%" Tag="66" Click="OnPresetClick" />
                <Button Content="100%" Tag="100" Click="OnPresetClick" />
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="OversizePanel" Spacing="8">
            <ComboBox x:Name="OversizeCombo" Header="Resize if image is" HorizontalAlignment="Stretch">
                <x:String>wider or higher</x:String>
                <x:String>wider</x:String>
                <x:String>higher</x:String>
            </ComboBox>
            <NumberBox x:Name="ThresholdBox" Header="than [px]" Minimum="1" Maximum="100000" SmallChange="1" LargeChange="100"
                       SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
            <NumberBox x:Name="TargetBox" Header="to (target) [px]" Minimum="1" Maximum="100000" SmallChange="1" LargeChange="100"
                       SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
        </StackPanel>
    </StackPanel>
</UserControl>
