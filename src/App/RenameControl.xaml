<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CbxConverter.RenameControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CbxConverter">

    <Grid RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <ComboBox x:Name="RenameTypeCombo" Header="Renaming" Width="280" SelectedIndex="0" SelectionChanged="OnOptionsChanged">
                <x:String>extract numbers from file names</x:String>
                <x:String>start from specified number</x:String>
            </ComboBox>
            <TextBox x:Name="PatternBox" Header="Pattern for new names (printf, e.g. %04d)" Width="260" Text="%04d" TextChanged="OnOptionsChanged" />
            <NumberBox x:Name="OffsetBox" Header="Offset to add / starting number" Width="220" Value="0"
                       SpinButtonPlacementMode="Inline" ValueChanged="OnOffsetChanged" />
            <Button x:Name="RenameButton" Style="{StaticResource AccentButtonStyle}" Content="Rename" VerticalAlignment="Bottom" Click="OnRename" />
        </StackPanel>

        <InfoBar x:Name="ErrorBar" Grid.Row="1" Severity="Error" IsOpen="False" IsClosable="True" />

        <Grid Grid.Row="2" Padding="16,0,16,0" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Old name" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="New name" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Size [B]" FontWeight="SemiBold" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="Width" FontWeight="SemiBold" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Text="Height" FontWeight="SemiBold" HorizontalAlignment="Right" />
        </Grid>

        <ListView x:Name="FileList" Grid.Row="3" SelectionMode="Extended" DoubleTapped="OnOpenFile">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="28" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:RenameItem">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind OldName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Bind NewName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Size}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="{x:Bind ImageWidth}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{x:Bind ImageHeight}" HorizontalAlignment="Right" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="Open file in default viewer" Click="OnOpenFile" />
                    <MenuFlyoutItem Text="Delete selected file(s)" Click="OnDeleteFiles">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </ListView.ContextFlyout>
        </ListView>
    </Grid>
</UserControl>
