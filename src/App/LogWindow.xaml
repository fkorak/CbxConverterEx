<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CbxConverter.LogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CbxConverterEx - Log">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView x:Name="LogList" SelectionMode="Extended" Padding="0,4,0,4">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="20" />
                    <Setter Property="Padding" Value="12,0,12,0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="NoWrap" />
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.KeyboardAccelerators>
                <KeyboardAccelerator Modifiers="Control" Key="C" Invoked="OnCopyAccelerator" />
            </ListView.KeyboardAccelerators>
        </ListView>

        <Grid Grid.Row="1" Padding="12,8,12,10" ColumnSpacing="8"
              BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="AutoScrollCheck" Content="Auto scroll" IsChecked="True" />
            <Button Grid.Column="1" Content="Copy" Click="OnCopy" />
            <Button Grid.Column="2" Content="Clear" Click="OnClear" />
        </Grid>
    </Grid>
</Window>
