<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="CbxConverter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CbxConverter"
    Title="CbxConverterEx">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.Resources>
            <Style x:Key="HeaderButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="4,4,4,4" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="CellStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Padding" Value="4,0,4,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="NumberCellStyle" TargetType="TextBlock" BasedOn="{StaticResource CellStyle}">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Add source file(s) (cbr, cbz, ...)..." Click="OnAddFiles">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8E5;" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Add files from source directory (recursively)..." Click="OnAddDirectory">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Open tmp directory" Click="OnOpenTmpDirectory" />
                <MenuFlyoutItem Text="Open output directory" Click="OnOpenOutputDirectory" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="OnExit" />
            </MenuBarItem>
            <MenuBarItem Title="View">
                <MenuFlyoutItem Text="Log" Click="OnShowLog">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="L" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Configuration">
                <MenuFlyoutItem Text="Settings..." Click="OnShowSettings">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About" Click="OnAbout" />
            </MenuBarItem>
        </MenuBar>

        <!-- column headers; widths must match item template -->
        <Grid x:Name="HeaderGrid" Grid.Row="1" Padding="16,0,16,0" BorderThickness="0,0,0,1"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="84" />
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="76" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Tag="0" Style="{StaticResource HeaderButtonStyle}" Click="OnHeaderClick" Content="Source file" />
            <Button Grid.Column="1" Tag="1" Style="{StaticResource HeaderButtonStyle}" HorizontalContentAlignment="Right" Click="OnHeaderClick" Content="Size [kB]" />
            <Button Grid.Column="2" Tag="2" Style="{StaticResource HeaderButtonStyle}" HorizontalContentAlignment="Right" Click="OnHeaderClick" Content="Images" />
            <Button Grid.Column="3" Tag="3" Style="{StaticResource HeaderButtonStyle}" HorizontalContentAlignment="Right" Click="OnHeaderClick" Content="kB/img" />
            <Button Grid.Column="4" Tag="4" Style="{StaticResource HeaderButtonStyle}" Click="OnHeaderClick" Content="Img width" />
            <TextBlock Grid.Column="5" Text="Resize" FontWeight="SemiBold" VerticalAlignment="Center" Padding="4,0" />
            <TextBlock Grid.Column="6" Text="Status" FontWeight="SemiBold" VerticalAlignment="Center" Padding="4,0" />
            <Button Grid.Column="7" Tag="7" Style="{StaticResource HeaderButtonStyle}" HorizontalContentAlignment="Right" Click="OnHeaderClick" Content="Out [kB]" />
            <Button Grid.Column="8" Tag="8" Style="{StaticResource HeaderButtonStyle}" HorizontalContentAlignment="Right" Click="OnHeaderClick" Content="Out/in" />
        </Grid>

        <ListView x:Name="FileList" Grid.Row="2" SelectionMode="Extended" IsMultiSelectCheckBoxEnabled="False"
                  KeyDown="OnFileListKeyDown" RightTapped="OnFileListRightTapped" DoubleTapped="OnFileListDoubleTapped">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="12,0,12,0" />
                    <Setter Property="MinHeight" Value="34" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SourceFileItem">
                    <Grid ToolTipService.ToolTip="{x:Bind FullPath}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CellStyle}" Text="{x:Bind Name}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource NumberCellStyle}" Text="{x:Bind Size, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource NumberCellStyle}" Text="{x:Bind Images, Mode=OneWay}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource NumberCellStyle}" Text="{x:Bind SizePerImage, Mode=OneWay}" />
                        <TextBlock Grid.Column="4" Style="{StaticResource CellStyle}" Text="{x:Bind ImageWidth, Mode=OneWay}" />
                        <TextBlock Grid.Column="5" Style="{StaticResource CellStyle}" Text="{x:Bind Resize, Mode=OneWay}" />
                        <Grid Grid.Column="6" Padding="4,0,4,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE783;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                          Visibility="{x:Bind IsError, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Status, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ProgressBar VerticalAlignment="Bottom" Margin="0,0,0,-6" Maximum="100"
                                         Value="{x:Bind Progress, Mode=OneWay}" Visibility="{x:Bind ProgressVisible, Mode=OneWay}" />
                        </Grid>
                        <TextBlock Grid.Column="7" Style="{StaticResource NumberCellStyle}" Text="{x:Bind OutSize, Mode=OneWay}" />
                        <TextBlock Grid.Column="8" Style="{StaticResource NumberCellStyle}" Text="{x:Bind Ratio, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ContextFlyout>
                <MenuFlyout x:Name="FileListMenu" Opening="OnFileListMenuOpening">
                    <MenuFlyoutItem Text="Resize..." Click="OnResize">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE740;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Rename image files in temporary folder..." Click="OnRename">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE8AC;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <ToggleMenuFlyoutItem x:Name="SkipPackingItem" Text="Skip packing back (leave in temporary folder)" Click="OnSkipPacking" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem x:Name="OpenTmpItem" Text="Open temporary folder" Click="OnOpenItemTmp" />
                    <MenuFlyoutItem x:Name="ShowOutputItem" Text="Show output file in Explorer" Click="OnShowOutputFile" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Select all" Click="OnSelectAll" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Remove selected file(s) from list" Click="OnRemoveFiles">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE738;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Delete source file(s)..." Click="OnDeleteSourceFiles">
                        <MenuFlyoutItem.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Text="Delete output file(s)..." Click="OnDeleteOutputFiles" />
                    <MenuFlyoutItem Text="Clear converted from list" Click="OnClearConverted" />
                </MenuFlyout>
            </ListView.ContextFlyout>
        </ListView>

        <StackPanel x:Name="EmptyHint" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False">
            <FontIcon Glyph="&#xE896;" FontSize="40" Opacity="0.5" />
            <TextBlock Text="Drop cbr / cbz / cb7 / cbt / pdf files or folders here" Opacity="0.6" />
        </StackPanel>

        <Grid Grid.Row="3" Padding="16,10,16,12" ColumnSpacing="8"
              BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button x:Name="StopButton" Grid.Column="1" Click="OnStop" IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                    <TextBlock Text="Stop" />
                </StackPanel>
            </Button>
            <Button x:Name="StartButton" Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Click="OnStartConversion">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                    <TextBlock Text="Start conversion" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
